{
  "name": "xq-exercices-miniapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "format:check": "prettier --check .",
    "lint": "npm run lint:only && npm run test:no-only",
    "lint:only": "eslint . --max-warnings=0",
    "check": "svelte-check --tsconfig ./tsconfig.app.json",
    "test:no-only": "node scripts/check-no-only.mjs",
    "test:unit": "vitest run --coverage",
    "test:traceability": "node scripts/generate-fit-traceability.mjs --enforce",
    "build": "vite build",
    "preview:test": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "start": "node server.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-basic-auth": "^1.2.1",
    "idb": "8.0.4",
    "svelte": "5.57.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "4.1.1",
    "axe-core": "4.14.0",
    "eslint": "10.12.0",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-svelte": "3.23.1",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "playwright-core": "1.64.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.6",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "4.1.1"
  }
}
